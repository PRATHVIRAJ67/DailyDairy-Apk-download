// DailyDairy app download page: static page plus a Worker that hands out the APK from R2.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dailydairy-download",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "workers_dev": true,
  // Add a custom domain once you have one, e.g. "routes": [{ "pattern": "download.yourdomain.in", "custom_domain": true }]
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these paths hit the Worker; everything else is served straight from ./public.
    "run_worker_first": ["/apk", "/api/*"]
  },
  "r2_buckets": [{ "binding": "APK", "bucket_name": "dailydairy-downloads" }]
  // The signing secret is NOT here: set it with
  //   npx wrangler secret put DOWNLOAD_SECRET
}
